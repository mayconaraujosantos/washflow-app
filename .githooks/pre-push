#!/usr/bin/env bash
# Fast checks before a push, so a broken build never reaches develop/main
# (Argo's CI runs the full suite after the push). Enable once per clone with
# `make hooks`; skip in an emergency with `git push --no-verify`.
#
# Checks the working tree as it is: commit or stash unrelated work first if
# it does not build yet.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

step() { printf '\n==> %s\n' "$1"; }

step "backend: formatting and compilation (spotlessCheck, compileJava, compileTestJava)"
./gradlew -q spotlessCheck compileJava compileTestJava

step "frontend: lint, formatting and types"
(cd web && bun run --silent lint && bun run --silent format:check && bunx tsc -b)

printf '\n==> ok, pushing\n'
