# Local development settings (copy to .env; .env is git-ignored).
# The app only runs on PostgreSQL: start it with `make db-up`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=washflow
DB_USER=washflow
DB_PASSWORD=washflow

# Podman on Windows: if localhost:5432 is refused, use the VM address instead,
# e.g. DB_HOST=172.18.235.168 (find it with: podman machine ssh "ip -4 addr show eth0").
