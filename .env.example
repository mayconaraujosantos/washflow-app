# Local development settings (copy to .env; .env is git-ignored).
# The app only runs on PostgreSQL: start it with `make db-up`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=washflow
DB_USER=washflow
DB_PASSWORD=washflow

# Podman on Windows: if localhost:5432 is refused, use the VM address instead,
# e.g. DB_HOST=172.18.235.168 (find it with: podman machine ssh "ip -4 addr show eth0").

# "Esqueci a senha" by e-mail code. Without SMTP_HOST, development writes the
# e-mail (with the code) to the server log. Any SMTP relay works, e.g. Brevo:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=Washflow <nao-responda@seudominio.com>

# Código de acesso do cliente por e-mail (EMAIL_CHANNEL: smtp, log ou none).
# Local: `docker compose up -d mailpit` e veja os e-mails em http://localhost:8025.
EMAIL_CHANNEL=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM=nao-responda@washflow.local
# Produção (ex.: Brevo, Resend, Amazon SES): SMTP_SECURITY=starttls (587) ou ssl (465),
# SMTP_USERNAME / SMTP_PASSWORD do provedor e um SMTP_FROM de domínio verificado.

# Código de acesso do cliente por WhatsApp (OTP_CHANNEL: evolution, log ou none).
# evolution envia pela Evolution API (infra/README.md, "WhatsApp"); log escreve no log.
# OTP_CHANNEL=evolution
# EVOLUTION_URL=http://localhost:8082
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=washflow
