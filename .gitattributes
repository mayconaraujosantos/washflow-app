# Text files are LF in the repository and in every working copy, whatever the
# machine's core.autocrlf: Prettier, Spotless and the shell scripts expect LF,
# and the Windows default (autocrlf=true) turned every file into CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
