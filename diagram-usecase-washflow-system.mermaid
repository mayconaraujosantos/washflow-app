%% Fluxo de uso do Washflow (multi-lava-jato). Detalhes e diagramas de sequência: docs/system-design/
graph TD
    classDef admin fill:#e2d9f3,stroke:#333,stroke-width:2px;
    classDef cliente fill:#d4ebf2,stroke:#333,stroke-width:2px;
    classDef lavador fill:#ffe5b4,stroke:#333,stroke-width:2px;
    classDef gerente fill:#d1e7dd,stroke:#333,stroke-width:2px;
    classDef sistema fill:#f8d7da,stroke:#f5c2c7,stroke-width:1px,stroke-dasharray: 5 5;

    %% 0. Plataforma
    subgraph P0 [0. PLATAFORMA - Administrador]
        S1[Instalação nova: /configurar cria o administrador<br/>SETUP_CODE em produção] --> S2["/admin: cria o lava-jato<br/>horário, capacidade, gerente inicial"]
        S2 --> S3[Catálogo e categorias de despesa padrão<br/>+ link /?lavajato=slug para o balcão]
        S2 -.->|suspender / reativar| S4[Lava-jato suspenso: sem acesso, dados preservados]
    end

    %% 1. Cliente
    subgraph C1 [1. CLIENTE - PWA]
        A[Abre o link/QR do balcão ou busca o lava-jato pelo nome] --> A2[Entra ou cria conta<br/>telefone+senha, WhatsApp ou Google]
        A2 --> B[Escolhe veículo, serviço, dia e hora livre]
        B --> VALIDA{Horário de funcionamento,<br/>antecedência e vaga na hora?}
        VALIDA -->|Não| B
        VALIDA -->|Sim: reserva atômica| C[AGENDADO]
        C --> D(Painel do cliente<br/>atualiza a cada 3 s)
    end

    %% 2. Gerente: entrada
    subgraph G1 [2. GERENTE - entrada]
        GL[Login: e-mail + senha] --> E[Agenda do dia]
        C --> E
        E --> F[Recebe o carro agendado]
        W[Carro chega sem agendamento:<br/>entrada pela placa] --> PLACA{Carro já está no pátio?}
        PLACA -->|Sim| W409[Recusado: finalize o atendimento atual]
        PLACA -->|Não| G
        F --> G[AGUARDANDO_PATIO]
        G -.-> TK[Ticket por QR/link/WhatsApp<br/>/ticket/:token sem login]
    end

    %% 3. Lavador
    subgraph L1 [3. LAVADOR - PWA]
        LL[Login: crachá QR ou telefone + PIN] --> H
        G --> H[Fila: AGUARDANDO_PATIO por atualizado_em ASC]
        H --> I{Iniciar lavagem}
        I -->|Outro lavador pegou antes| H
        I -->|Primeiro| J[EM_LAVAGEM]
        J <-->|almoço, banheiro, outro| JP[PAUSADA]
        J --> K[Concluir: PRONTO]
    end

    %% 4. Gerente: saída
    subgraph G2 [4. GERENTE - saída e balcão]
        K --> M[Valida a lavagem]
        M --> N[Recebe: dinheiro, Pix, débito ou crédito]
        N -->|uma transação: status + pagamento + comissão| O[FINALIZADO]
        V[Venda rápida / orçamento] --> CX[Caixa: entradas e despesas]
        O --> R[Relatórios: faturamento, comissões, tempo médio]
    end

    K -.->|painel e ticket mostram| PR[Orientação de retirada]
    D -.-> PR
    N -.->|clique duplo ou reenvio: Idempotency-Key / 409| DUP[Nunca duplica]

    class S1,S2,S3,S4 admin;
    class A,A2,B,C,D cliente;
    class LL,H,I,J,JP,K lavador;
    class GL,E,F,W,G,M,N,O,V,CX,R,PLACA,W409,TK gerente;
    class VALIDA,PR,DUP sistema;
