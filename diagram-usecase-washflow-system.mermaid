graph TD
    %% Estilos
    classDef cliente fill:#d4ebf2,stroke:#333,stroke-width:2px;
    classDef lavador fill:#ffe5b4,stroke:#333,stroke-width:2px;
    classDef gerente fill:#d1e7dd,stroke:#333,stroke-width:2px;
    classDef notificacao fill:#f8d7da,stroke:#f5c2c7,stroke-width:1px,stroke-dasharray: 5 5;

    %% Canal do Cliente
    subgraph C1 [1. VISÃO DO CLIENTE - PWA]
        A[Acessa Link/QR Code] --> B[Escolhe Lavagem, Data/Hora]
        B --> VALIDA{Valida Vagas e Horário Comercial?}
        
        VALIDA -->|Não: Erro/Pátio Lotado| B
        VALIDA -->|Sim| C[Salva Agendamento]
        
        C -->|Gera Notificação| NOT1[🔔 Recebe Confirmação de Agendamento]
        C -->|Status: AGENDADO| D(Acompanha Painel de Status no Celular)
    end

    %% Canal do Gerente (Entrada)
    subgraph G1 [3. VISÃO DO GERENTE - Painel]
        C --> E[Vê Carro na Agenda do Dia]
        E --> F[Cliente Chega: Recebe o Carro no Pátio]
        F -->|Status: AGUARDANDO_PATIO| G[Disponibiliza na Fila Geral do Pátio]
    end

    %% Canal do Lavador
    subgraph L1 [2. VISÃO DO LAVADOR - PWA]
        G --> H[Vê Carro Livre na Fila do PWA]
        H --> I[Clica em 'Iniciar Lavagem' - Puxa o Carro para Si]
        
        I -->|Status: EM LAVAGEM| NOT2[🔔 Notifica Cliente: Lavagem Iniciada]
        I --> J[Realiza o Serviço no Veículo]
        J --> K[Clica em 'Concluir Lavagem']
    end

    %% Canal do Gerente / Cliente (Saída)
    K -->|Status: PRONTO| NOT3[🔔 Notifica Cliente: Carro Pronto para Retirada]
    K --> M[Gerente Valida a Qualidade da Lavagem]
    M --> N[Registra Cobrança / Recebe Pagamento]
    N -->|Status: FINALIZADO| O[Libera o Carro para o Cliente]
    O --> P[Sistema calcula e credita Comissão do Lavador]

    %% Aplicando Classes
    class A,B,C,D cliente;
    class H,I,J,K lavador;
    class E,F,G,M,N,O,P gerente;
    class NOT1,NOT2,NOT3 notificacao;
